<?xml version="1.0" encoding="utf-8"?>
<!--
    ScenesManager.uxml: a panel with a title, a close button, and a container that ScenesManager.lua fills with one
    button per scene (styled by the module_button and button_label classes).
-->
<UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="UnityEngine.UIElements"
    xmlns:hr="Highrise.UI"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
  <hr:UILuaView class="scenes-manager">
    <VisualElement class="content-panel">
      <VisualElement class="header">
        <Label name="_title" class="header-title" text="Scenes" />
        <VisualElement name="_closeButton" class="close-button">
          <Label class="close-label" text="X" />
        </VisualElement>
      </VisualElement>

      <hr:UIScrollView class="scroll">
        <VisualElement name="_container" class="container" />
      </hr:UIScrollView>
    </VisualElement>
  </hr:UILuaView>
</UXML>
