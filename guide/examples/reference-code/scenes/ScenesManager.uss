/* ScenesManager.uss: styles for ScenesManager.uxml and the buttons ScenesManager.lua creates */

.scenes-manager {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    color: white;
    -unity-font-definition: var(--font-bold);
}

.content-panel {
    width: 90%;
    max-width: 400px;
    max-height: 80%;
    padding: 16px;
    background-color: #141317;
    border-radius: 12px;
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.header-title {
    font-size: 20px;
}

.close-button {
    width: 32px;
    height: 32px;
    justify-content: center;
    align-items: center;
}

.close-label {
    font-size: 18px;
}

.scroll {
    flex-shrink: 1;
}

.module_button {
    height: 44px;
    margin-bottom: 8px;
    border-radius: 8px;
    background-color: #3A3940;
    justify-content: center;
    align-items: center;
}

.button_label {
    font-size: 16px;
}
