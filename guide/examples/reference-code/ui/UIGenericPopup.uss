/* UIGenericPopup.uss: styles for UIGenericPopup.uxml */

.generic-popup {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    color: white;
    -unity-font-definition: var(--font-bold);
}

.close-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
}

.content-panel {
    width: 90%;
    max-width: 360px;
    padding: 20px;
    background-color: #141317;
    border-radius: 12px;
}

.message {
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.button-row {
    flex-direction: row;
    justify-content: center;
}

.button {
    flex-grow: 1;
    height: 44px;
    margin: 0 6px;
    border-radius: 8px;
    justify-content: center;
    align-items: center;
}

.ok-button {
    background-color: #6C4DFF;
}

.cancel-button {
    background-color: #3A3940;
}

.button-label {
    font-size: 16px;
    -unity-text-align: middle-center;
}
