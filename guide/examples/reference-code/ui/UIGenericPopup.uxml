<?xml version="1.0" encoding="utf-8"?>
<!--
    UIGenericPopup.uxml: a message popup with OK and optional Cancel buttons, over a dimmed overlay that closes it when tapped.
    Each name matches a Bind property in UIGenericPopup.lua.
-->
<UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="UnityEngine.UIElements"
    xmlns:hr="Highrise.UI"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
  <hr:UILuaView class="generic-popup">
    <!-- Full-screen overlay behind the panel; tapping it closes the popup -->
    <VisualElement name="_closeOverlay" class="close-overlay" />

    <VisualElement name="_content" class="content-panel">
      <Label name="_message" class="message" text="Message" />

      <VisualElement class="button-row">
        <hr:UIButton name="_cancelButton" class="button cancel-button">
          <Label class="button-label" text="Cancel" />
        </hr:UIButton>
        <hr:UIButton name="_okButton" class="button ok-button">
          <Label name="_okButtonText" class="button-label" text="OK" />
        </hr:UIButton>
      </VisualElement>
    </VisualElement>
  </hr:UILuaView>
</UXML>
