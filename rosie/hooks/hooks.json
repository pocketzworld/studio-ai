{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-version.cmd ${CLAUDE_PLUGIN_ROOT}"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/setup-serializer.cmd ${CLAUDE_PLUGIN_ROOT}"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/resolve-scene-refs.cmd ${CLAUDE_PLUGIN_ROOT}",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/update-docs.cmd ${CLAUDE_PLUGIN_ROOT}"
          }
        ]
      }
    ]
  }
}